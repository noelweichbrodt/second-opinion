# Optional: enables Gemini and full consensus mode.
# Codex uses the local Codex CLI with ChatGPT-plan authentication and needs no
# API key in this file.
GEMINI_API_KEY=

# Optional configuration
GEMINI_MODEL=gemini-pro-latest
CODEX_MODEL=gpt-5.6-sol
MAX_CONTEXT_TOKENS=200000
MAX_OUTPUT_TOKENS=32768
TEMPERATURE=0.3
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
REVIEWS_DIR=second-opinions

# Codex reasoning effort is intentionally not configurable here. The generated
# /codex:rescue command omits --effort, which preserves the "ultra" setting
# inherited from ~/.codex/config.toml.
